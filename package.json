    "lint": "eslint .",
    "test:frame-router": "esbuild scripts/frame-router-regression.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/frame-router-regression.mjs && node node_modules/.tmp/frame-router-regression.mjs",
    "test:param-batch-read": "esbuild scripts/param-batch-read-regression.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/param-batch-read-regression.mjs && node node_modules/.tmp/param-batch-read-regression.mjs",
