POSTGRES_IMAGE=postgres:18-alpine
MOSQUITTO_IMAGE=eclipse-mosquitto:2
NODERED_BASE_IMAGE=nodered/node-red:latest
NPM_REGISTRY=

POSTGRES_DB=wireless_debug
POSTGRES_USER=wireless_debug
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_POOL_MAX=10

MQTT_PORT=1883
NODERED_PORT=1880
NODE_RED_CREDENTIAL_SECRET=change-this-node-red-secret

# Optional. Generate a bcrypt hash with:
# node-red admin hash-pw
# CLOUD_HTTP_USER=debug
# CLOUD_HTTP_PASSWORD_HASH=$2b$08$...
