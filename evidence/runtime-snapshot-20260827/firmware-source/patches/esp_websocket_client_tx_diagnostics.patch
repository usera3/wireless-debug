+esp_err_t esp_websocket_client_get_tx_diagnostics(
+    esp_websocket_client_handle_t client,
+    esp_websocket_client_tx_diagnostics_t *out)
+{
+    if (client == NULL || out == NULL) {
+        return ESP_ERR_INVALID_ARG;
+    }
+
+    out->data_lock_wait_max_us = __atomic_load_n(
+        &client->tx_diagnostics.data_lock_wait_max_us, __ATOMIC_RELAXED);
+    out->data_lock_timeouts = __atomic_load_n(
+        &client->tx_diagnostics.data_lock_timeouts, __ATOMIC_RELAXED);
+    out->transport_send_max_us = __atomic_load_n(
+        &client->tx_diagnostics.transport_send_max_us, __ATOMIC_RELAXED);
+    out->ping_lock_wait_max_us = __atomic_load_n(
+        &client->tx_diagnostics.ping_lock_wait_max_us, __ATOMIC_RELAXED);
+    out->ping_lock_timeouts = __atomic_load_n(
+        &client->tx_diagnostics.ping_lock_timeouts, __ATOMIC_RELAXED);
+    out->ping_send_max_us = __atomic_load_n(
+        &client->tx_diagnostics.ping_send_max_us, __ATOMIC_RELAXED);
+    return ESP_OK;
