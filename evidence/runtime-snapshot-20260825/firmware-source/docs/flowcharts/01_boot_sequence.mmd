flowchart TD
    A([ESP32-S3 上电 / app_main]) --> B[NVS 初始化]
    B --> C{NVS 分区可用?}
    C -- 否: NO_FREE_PAGES 或 NEW_VERSION --> C1[擦除 NVS]
    C1 --> C2[重新初始化 NVS]
    C -- 是 --> D[app_core_init<br/>默认 UART=2Mbps<br/>默认通信=AUTO]
    C2 --> D

    D --> E{CONFIG_ENABLE_BLE?}
    E -- 是 --> E1[ble_spp_transport_init<br/>注册 BLE RX/ready/status/heap 回调]
    E -- 否 --> F[ui_controller_init]
    E1 --> F

    F --> F1[ui_controller_init<br/>注册 WiFi/UART/BLE/heap 操作回调]
    F1 --> G{CONFIG_ENABLE_WIFI?}
    G -- 是 --> G1[esp_netif_init]
    G1 --> G2[esp_event_loop_create_default]
    G -- 否 --> H[启动 UART transport]
    G2 --> H

    H --> H1[uart_transport_start]
    H1 --> H2[安装 UART1 driver<br/>TX GPIO10, RX GPIO9<br/>RX/TX ring buffer 32KB]
    H2 --> H3[设置 RX timeout 和 RX full threshold]
    H3 --> H4[创建 uart_transport_task<br/>负责事件读取和软件组帧]

    H4 --> I[display_port_init]
    I --> I1{SSD1315 I2C 探测成功?}
    I1 -- 是 --> I2[初始化 SSD1315 OLED<br/>写入启动测试图案]
    I1 -- 否 --> I3[记录 display_status=ssd1315_missing<br/>主程序告警后继续]
    I2 --> J[display_lvgl_start]
    I3 --> J

    J --> J1[lv_init 和 system_menu_init]
    J1 --> J2[创建 128x64 LVGL display<br/>绑定 flush 回调]
    J2 --> J3[display_ui_build<br/>构建状态栏/标题/4行/页脚]
    J3 --> J4[启动 5ms LVGL tick timer]
    J4 --> J5[创建 display_lvgl_task<br/>20ms 周期刷新 UI]
    J5 --> J6[设置当前 UART 波特率到显示状态]

    J6 --> K{CONFIG_ENABLE_WIFI?}
    K -- 是 --> K1[web_static_init<br/>挂载 SPIFFS storage 分区]
    K1 --> K2[wifi_manager_init]
    K2 --> K3[创建默认 AP/STA netif<br/>AP DHCP 不发布网关/DNS]
    K3 --> K4[esp_wifi_init<br/>注册 STA_DISCONNECTED / GOT_IP 事件]
    K4 --> K5[创建 STA 连接超时回退 timer]
    K5 --> K6[从 NVS 读取 STA 配置<br/>若无则使用默认 STA 配置]
    K6 --> K7[生成 AP SSID: ESP32-S3_AP_XXXX]
    K7 --> K8{有 STA 配置且允许开机 STA?}
    K8 -- 是 --> K9[请求 SYSTEM_NET_STA<br/>启动 APSTA 并连接外部 WiFi]
    K8 -- 否 --> K10[请求 SYSTEM_NET_AP<br/>启动 SoftAP]
    K9 --> K11[start_webserver]
    K10 --> K11
    K -- 否 --> L{CONFIG_ENABLE_BLE<br/>且 CONFIG_BLE_START_ON_BOOT?}

    K11 --> K12[wifi_transport_init<br/>创建 WS 发送队列/静态帧池/发送任务]
    K12 --> K13[httpd_start<br/>端口 80, wildcard 匹配, 96 handlers]
    K13 --> K14[注册 web_api handlers<br/>/api/...]
    K14 --> K15[注册 WebSocket<br/>/ws]
    K15 --> K16[注册 web_static handlers<br/>Excel API 和 /* 静态文件]
    K16 --> L

    L -- 是 --> L1[ble_spp_transport_start]
    L1 --> L2[nimble_port_init]
    L2 --> L3[初始化 GAP/GATT<br/>SPP UUID 0xABF0/0xABF1]
    L3 --> L4[创建 NimBLE host task]
    L4 --> L5[BLE sync 后设置设备名并开始广播]
    L -- 否 --> M[health_reporter_start]
    L5 --> M

    M --> M1[创建 health_report_task<br/>每 30 秒或错误变化输出 HEALTH OK/ALERT]
    M1 --> N[打印固件配置日志]
    N --> O([app_main 返回<br/>各 FreeRTOS 任务持续运行])

    subgraph RuntimeTasks[持续运行的主要任务/定时器]
        RT1[uart_transport_task<br/>UART RX 组帧]
        RT2[wifi_send_task<br/>WebSocket 异步发送]
        RT3[NimBLE host task<br/>BLE GAP/GATT]
        RT4[display_lvgl_task<br/>刷新 OLED UI]
        RT5[health_report_task<br/>串口健康日志]
        RT6[WiFi event loop<br/>STA 断线/GOT_IP]
        RT7[HTTP server task<br/>API/静态文件/WS handler]
    end

    O -. 启动后并行 .-> RuntimeTasks
